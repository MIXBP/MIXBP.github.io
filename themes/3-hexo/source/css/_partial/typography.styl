/* 文章排版优化: 标题/链接/行内代码/代码框/图片/分割线 */
#post
  .article-title
    font-size 1.85em
    line-height 1.4
    letter-spacing .5px
  .pjax article
    .article-entry
      h1, h2, h3, h4, h5, h6
        line-height 1.5
      h2
        margin 1.9em 0 .9em
        padding-bottom .35em
        border-bottom 1px solid #e8eaed
        font-size 1.42em
      h3
        margin 1.55em 0 .75em
        font-size 1.2em
      h4
        margin 1.4em 0 .7em
        font-size 1.06em
      p
        margin 1.05em 0
        letter-spacing .2px
      a
        color #2f9e78
        text-decoration none
        border-bottom 1px solid rgba(47, 158, 120, .35)
        transition color .15s, border-color .15s
        &:hover
          color #1f7d5c
          border-bottom-color #1f7d5c
      :not(pre) > code
        border-radius 4px
        padding .12em .45em
        margin 0 2px
        font-size 86%
        color #d0436b
        background #f8eef1
        border 1px solid #f0dce2
      pre
        border-radius 8px
        box-shadow 0 1px 5px rgba(30, 40, 60, .08)
        & > code
          border-radius 8px
          font-size 13.5px
          line-height 1.62
          font-family "JetBrains Mono", "Cascadia Code", Menlo, Monaco, Consolas, "Courier New", monospace
      img
        border-radius 6px
        box-shadow 0 2px 14px rgba(20, 30, 50, .1)
      hr
        border none
        border-top 1px solid #e8eaed
        margin 2em 0
      blockquote
        border-left 3px solid #309E85
        border-radius 0 6px 6px 0
      table
        border-radius 6px
        overflow hidden
