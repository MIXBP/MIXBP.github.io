<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemscope itemprop="blogPost">
    <% if (post.title){ %>
        <h1 class="article-title"><%= post.title %></h1>
    <% } %>
    <div class="article-meta">
        <% if (post.top){ %>
        <span class="top"><a><%= __('titles.pin_to_top') %></a></span>
        <%}%>
        <% if (theme.author.on==true && post.author) {%>
        <span class="author"><a><%=post.author %></a></span>
        <%}%>
        <% if (post.categories && post.categories.length){ %>
        <span class="book">
            <i class="iconfont icon-category"></i>
            <% var categoryPath = []%>
            <% post.categories.forEach(function(category, i){ categoryPath.push(category.name)%>
            <a  data-rel="<%=categoryPath.join('<--->')%>"><%=category.name%></a><% if (i !== post.categories.length - 1) { %> <% if (theme.category && theme.category.sub) {%>><%} else {%>/<%}%> <% } %>
            <% }) %>
        </span>
        <% } %>
        <% if (post.tags && post.tags.length){ %>
        <span class="tag">
            <i class="iconfont icon-tag"></i>
            <% post.tags.forEach(function(tag, i){ %>
            <a class="color<%= tag.name.length % 5 + 1 %>"><%=tag.name%></a>
            <% }) %>
        </span>
        <% } %>
    </div>
    <div class="article-meta">
        <% if (post.date){ %>
            <%= __('post.created_at') %> : <time class="date" title='<%= __('post.updated_at') %>: <%= date(post.updated, 'YYYY-MM-DD HH:mm:ss')%>'><%= date(post.date, 'YYYY-MM-DD HH:mm') %></time>
        <% } %>
    </div>
    <div class="article-meta">
        <%if(theme.word_count){%>
        <span><%= __('post.word_count') %>:<%=wordcount(post.content) %></span>
        <span><%= __('post.reading_time', min2read(post.content)) %></span>
        <%}%>
        <%if(theme.visit_counter && theme.visit_counter.on && theme.visit_counter.page_visit) {%>
        <span id="busuanzi_container_page_pv">
            <%= __('post.views') %> :<span id="busuanzi_value_page_pv">
                <span class="count-comment">
                    <span class="spinner">
                      <div class="cube1"></div>
                      <div class="cube2"></div>
                    </span>
                </span>
            </span>
        </span>
        <%}%>
        <%if(theme.comment.on && theme.comment.type && theme.comment.comment_count){%>
        <span class="top-comment" title="<%= __('titles.jump_to_comment_area') %>">
            <a href="#comments">
                <%= __('post.comment') %>:<span class="count-comment">
                    <span class="spinner">
                      <div class="cube1"></div>
                      <div class="cube2"></div>
                    </span>
                </span>
            </a>
        </span>
        <%}%>
    </div>
    <%if(post.originUrl){%>
    <div class="article-meta">
        <span class="origin"><%= __('titles.original') %>:
            <a href="<%=post.originUrl%>" target="_blank">
                <%if(post.originView){%>
                <%= post.originView%>
                <%} else {%>
                <%=post.originUrl%>
                <%}%>
            </a>
        </span>
    </div>
    <%}%>
    <%- partial('_partial/toc-ref', {index: false}) %>
    <% post.content = post.content.replace(/\[TOC\]/gi, "<div class='inner-toc'>" + toc(post.content, {list_number: false}) + '</div>') %>
    <div class="article-entry" itemprop="articleBody">
      <% if (post.excerpt && index){ %>
        <%- post.excerpt %>
        <% if (theme.excerpt_link){ %>
          <p class="article-more-link">
            <a href="<%- url_for(post.path) %>#more"><%= theme.excerpt_link %></a>
          </p>
        <% } %>
      <% } else { %>
        <%- post.content %>
      <% } %>
       <% if(theme.article_txt){%><hr><span style="font-style: italic;color: gray;"> <%=theme.article_txt%> </span><%}%>
    </div>
</article>

<% if(theme.reward){%>
<p>
    <a  class="dashang" onclick="dashangToggle()"><%= __('donation.button') %></a>
</p>
<%}%>
<%- partial('_partial/article_copyright')%>
<% if (!index) { %>
<%
/* 相关文章: 按共享标签数评分,同分按日期降序 */
var postTagNames = (post.tags && post.tags.data) ? post.tags.data.map(function(t){ return t.name; }) : [];
var related = site.posts.data.filter(function(p) {
    if (p.path === post.path || !postTagNames.length) return false;
    return !!(p.tags && p.tags.data && p.tags.data.length && p.tags.data.some(function(t){ return postTagNames.indexOf(t.name) !== -1; }));
}).map(function(p) {
    var score = p.tags.data.filter(function(t){ return postTagNames.indexOf(t.name) !== -1; }).length;
    return { p: p, score: score };
}).sort(function(a, b) {
    return (b.score - a.score) || (b.p.date - a.p.date);
}).slice(0, 5);
%>
<% if (related.length) { %>
<div class="related-posts">
    <div class="related-title"><i class="iconfont icon-tag"></i> <%= __('titles.related') %></div>
    <ul>
        <% related.forEach(function(r){ %>
        <li>
            <a href="<%- url_for(r.p.path) %>"><%= r.p.title %></a>
            <span class="related-date"><%= date(r.p.date, 'YYYY-MM-DD') %></span>
        </li>
        <% }) %>
    </ul>
</div>
<% } %>
<% } %>
<%- partial('_partial/comment', {post: post, index: index})%>

<% if (theme.mathjax.on){ %>
    <% if (theme.mathjax.per_page){ %>
        <%- partial('mathjax') %>
    <% } else if(page.mathjax){ %>
        <%- partial('mathjax') %>
    <% }%>
<% } %>

<% if (page.bgImg) {%>
    <style>
        #post {
            background: url(<%=page.bgImg%>) !important;
        }
    </style>
<% }%>
