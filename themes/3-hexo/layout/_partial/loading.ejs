<div id="page-loading">
    <img class="nyan" src="/img/nyan.gif" alt="">
    <span class="star s1"></span><span class="star s2"></span><span class="star s3"></span>
    <span class="star s4"></span><span class="star s5"></span><span class="star s6"></span>
    <div class="pl-txt">MIXBP<span class="pl-cursor">▌</span></div>
</div>
<style>
    /* 彩虹猫 loading (Nyan Cat meme) */
    #page-loading { position: fixed; inset: 0; z-index: 99999; background: #003265;
        display: flex; align-items: center; justify-content: center;
        transition: opacity .35s ease; overflow: hidden; }
    #page-loading.done { opacity: 0; pointer-events: none; }
    #page-loading .nyan { width: 300px; max-width: 60vw; image-rendering: pixelated;
        margin-right: auto; margin-left: 0;
        animation: nyan-bob .55s ease-in-out infinite alternate; }
    @keyframes nyan-bob { from { transform: translateY(-7px); } to { transform: translateY(7px); } }
    #page-loading .star { position: absolute; width: 4px; height: 4px; background: #fff;
        border-radius: 50%; opacity: .8; animation: twinkle 1.6s ease-in-out infinite; }
    #page-loading .star.s1 { left: 55%; top: 22%; }
    #page-loading .star.s2 { left: 72%; top: 55%; width: 6px; height: 6px; background: #ffe27a; animation-delay: .4s; }
    #page-loading .star.s3 { left: 85%; top: 30%; animation-delay: .8s; }
    #page-loading .star.s4 { left: 62%; top: 74%; width: 3px; height: 3px; animation-delay: 1.1s; }
    #page-loading .star.s5 { left: 90%; top: 62%; animation-delay: .2s; }
    #page-loading .star.s6 { left: 48%; top: 12%; width: 3px; height: 3px; animation-delay: .6s; }
    @keyframes twinkle { 0%, 100% { opacity: .85; transform: scale(1); } 50% { opacity: .15; transform: scale(.5); } }
    #page-loading .pl-txt { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        margin-left: 90px; font-family: Consolas, monospace; font-size: 18px; font-weight: bold;
        color: #fff; letter-spacing: 4px; text-shadow: 2px 2px 0 rgba(0, 0, 0, .35); }
    #page-loading .pl-cursor { color: #ffe27a; animation: pl-blink 1s steps(2) infinite; }
    @keyframes pl-blink { 50% { opacity: 0; } }
</style>
<script>
    (function () {
        function hide() {
            var l = document.getElementById('page-loading');
            if (!l || l.classList.contains('done')) return;
            l.classList.add('done');
            setTimeout(function () { if (l.parentNode) l.parentNode.removeChild(l); }, 420);
        }
        /* HTML 解析完(正文可见)即放行, 不等图片; 6 秒兜底 */
        if (document.readyState !== 'loading') hide();
        else document.addEventListener('DOMContentLoaded', hide);
        setTimeout(hide, 6000);
    })();
</script>
