<div id="page-loading">
    <div class="cloud c1"></div><div class="cloud c2"></div><div class="cloud c3"></div>
    <div class="wave-zone">
        <svg id="pl-svg" viewBox="0 0 560 100" xmlns="http://www.w3.org/2000/svg">
            <defs><clipPath id="plclip"><rect id="pl-cliprect" x="-4" y="-10" width="0" height="120"/></clipPath></defs>
            <g clip-path="url(#plclip)">
                <path id="rb0" class="rb"/><path id="rb1" class="rb"/><path id="rb2" class="rb"/>
                <path id="rb3" class="rb"/><path id="rb4" class="rb"/><path id="rb5" class="rb"/>
            </g>
        </svg>
        <img id="pl-nyan" src="/img/nyan-cat.webp" alt="">
        <div class="pl-pct" id="pl-pct">0%</div>
    </div>
</div>
<style>
    /* 波浪状流动彩虹: SVG 六色正弦波, 猫在波前, 裁剪生长 0->100% */
    #page-loading { position: fixed; inset: 0; z-index: 99999; overflow: hidden;
        background: linear-gradient(#7ec3f0, #b5defa 62%, #ddf0fc);
        transition: opacity .4s ease; }
    #page-loading.fade { opacity: 0; pointer-events: none; }
    #page-loading .cloud { position: absolute; background: #fff; border-radius: 50px;
        opacity: .8; box-shadow: 0 6px 14px rgba(110, 150, 190, .22); }
    #page-loading .cloud::before, #page-loading .cloud::after { content: ''; position: absolute;
        background: #fff; border-radius: 50%; }
    #page-loading .c1 { width: 130px; height: 40px; left: 5%; top: 14%; animation: cloud-drift 26s linear infinite alternate; }
    #page-loading .c1::before { width: 55px; height: 55px; left: 22px; top: -26px; }
    #page-loading .c1::after { width: 40px; height: 40px; left: 66px; top: -16px; }
    #page-loading .c2 { width: 150px; height: 44px; right: 6%; top: 18%; opacity: .7; animation: cloud-drift 32s linear infinite alternate-reverse; }
    #page-loading .c2::before { width: 62px; height: 62px; left: 28px; top: -30px; }
    #page-loading .c3 { width: 110px; height: 36px; left: 8%; bottom: 14%; opacity: .7; animation: cloud-drift 28s linear infinite alternate; }
    #page-loading .c3::before { width: 50px; height: 50px; left: 24px; top: -24px; }
    @keyframes cloud-drift { from { transform: translateX(0); } to { transform: translateX(40px); } }
    .wave-zone { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: 560px; height: 130px; }
    #pl-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .rb { fill: none; stroke-width: 8.2; stroke-linecap: butt; }
    #pl-nyan { position: absolute; width: 108px; z-index: 3; left: -50px; top: 0;
        image-rendering: pixelated; pointer-events: none;
        filter: drop-shadow(1px 0 0 rgba(20, 50, 80, .8)) drop-shadow(-1px 0 0 rgba(20, 50, 80, .8))
                drop-shadow(0 1px 0 rgba(20, 50, 80, .8)) drop-shadow(0 -1px 0 rgba(20, 50, 80, .8))
                drop-shadow(0 6px 9px rgba(60, 100, 150, .5));
        animation: nyan-bob .5s ease-in-out infinite alternate; }
    @keyframes nyan-bob { from { margin-top: -5px; } to { margin-top: 4px; } }
    .pl-pct { position: absolute; left: 50%; top: 108px; transform: translateX(-50%);
        font-family: Consolas, monospace; font-size: 22px; font-weight: bold;
        color: #1c4e89; text-shadow: 1px 1px 0 rgba(255, 255, 255, .85); letter-spacing: 2px; }
</style>
<script>
    (function () {
        var W = 560, BAND = 8.2, AMP = 6, WAVELEN = 150, BASE = 26;
        var COLORS = ['#ff4d4d', '#ff9950', '#ffe14d', '#5ade5a', '#4da6ff', '#b066ff'];
        var paths = [];
        for (var b = 0; b < 6; b++) paths.push(document.getElementById('rb' + b));
        for (var c = 0; c < 6; c++) {
            paths[c].setAttribute('stroke', COLORS[c]);
            paths[c].setAttribute('stroke-width', BAND + 1.1);
        }
        var nyan = document.getElementById('pl-nyan');
        var cliprect = document.getElementById('pl-cliprect');
        var pctEl = document.getElementById('pl-pct');
        var phase = 0, pct = 0, target = 78, finished = false;
        var t0 = Date.now();

        function waveY(x, band) {
            return BASE + band * BAND + BAND / 2 + AMP * Math.sin((x + phase) / WAVELEN * Math.PI * 2);
        }
        function drawWave() {
            for (var b = 0; b < 6; b++) {
                var d = '';
                for (var x = 0; x <= W + 8; x += 7) {
                    d += (x === 0 ? 'M' : 'L') + x + ' ' + waveY(x, b).toFixed(1) + ' ';
                }
                paths[b].setAttribute('d', d);
            }
        }
        function setP(p) {
            pct = Math.max(0, Math.min(100, p));
            cliprect.setAttribute('width', (W * pct / 100 + 4).toFixed(1));
            pctEl.textContent = Math.round(pct) + '%';
            if (pct >= 100 && !finished) {
                finished = true;
                setTimeout(fade, 550);
            }
        }
        function fade() {
            var l = document.getElementById('page-loading');
            if (!l || l.classList.contains('fade')) return;
            l.classList.add('fade');
            setTimeout(function () { if (l.parentNode) l.parentNode.removeChild(l); }, 460);
        }
        /* 主循环: 波浪流动 + 猫贴在裁剪边缘 */
        var reveal = 0;
        function frame() {
            requestAnimationFrame(frame);
            phase += 1.15;
            drawWave();
            var edgeX = W * pct / 100;
            nyan.style.left = (edgeX - 44) + 'px';
            nyan.style.top = (waveY(Math.min(edgeX, W), 2) - 46) + 'px';
        }
        frame();

        /* 进度: 爬到 78% -> DOMContentLoaded 88% -> load 100% */
        var tick = setInterval(function () {
            if (pct < target) setP(pct + 2 + Math.random() * 4);
        }, 130);
        document.addEventListener('DOMContentLoaded', function () {
            target = 88;
            if (pct < 82) setP(82);
        });
        window.addEventListener('load', function () {
            target = 100;
            if (pct < 96) setP(96);
        });
        setTimeout(function () { target = 100; if (pct < 96) setP(96); }, 6000);
        setTimeout(function () { finished = true; fade(); }, 7200);
        function schedule() {
            var el = Date.now() - t0;
            setTimeout(function () {
                if (!finished && pct < 60) setP(60);
            }, Math.max(0, 1500 - el));
        }
        if (document.readyState !== 'loading') schedule();
        else document.addEventListener('DOMContentLoaded', schedule);

        /* 窄屏缩放 */
        function fit() {
            var s = Math.min(1, window.innerWidth / 640);
            document.querySelector('.wave-zone').style.transform =
                'translate(-50%, -50%) scale(' + s + ')';
        }
        window.addEventListener('resize', fit);
        fit();
    })();
</script>
