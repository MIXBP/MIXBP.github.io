<div id="page-loading">
    <span class="pstar" style="left:7%;top:14%"></span>
    <span class="pstar" style="left:20%;top:64%;animation-delay:.5s"></span>
    <span class="pstar" style="left:38%;top:26%;animation-delay:.9s"></span>
    <span class="pstar" style="left:58%;top:12%;animation-delay:.3s"></span>
    <span class="pstar" style="left:74%;top:58%;animation-delay:.7s"></span>
    <span class="pstar" style="left:88%;top:24%;animation-delay:1.1s"></span>
    <span class="pstar" style="left:92%;top:70%;animation-delay:.15s"></span>
    <span class="pstar" style="left:30%;top:78%;animation-delay:.6s"></span>
    <div class="wave-zone">
        <svg id="pl-svg" viewBox="0 0 560 110" xmlns="http://www.w3.org/2000/svg">
            <defs><clipPath id="plclip"><rect id="pl-cliprect" x="-4" y="-10" width="0" height="130"/></clipPath></defs>
            <g clip-path="url(#plclip)">
                <path id="rb0" class="rb"/><path id="rb1" class="rb"/><path id="rb2" class="rb"/>
                <path id="rb3" class="rb"/><path id="rb4" class="rb"/><path id="rb5" class="rb"/>
            </g>
        </svg>
        <img id="pl-nyan" src="/img/nyan-cat.webp" alt="">
    </div>
    <div class="pl-pct" id="pl-pct">0%</div>
</div>
<style>
    /* 经典彩虹猫 loading: 深蓝星空 + 原版猫 + 波浪彩虹进度 (0->100%) */
    #page-loading { position: fixed; inset: 0; z-index: 99999; overflow: hidden;
        background: #003265;
        transition: opacity .4s ease; }
    #page-loading.fade { opacity: 0; pointer-events: none; }
    /* 十字闪烁星星 (原版样式) */
    .pstar { position: absolute; width: 16px; height: 16px; opacity: .85;
        background:
            linear-gradient(#fff, #fff) center / 100% 3px no-repeat,
            linear-gradient(#fff, #fff) center / 3px 100% no-repeat;
        animation: star-twinkle 1.6s ease-in-out infinite; }
    @keyframes star-twinkle {
        0%, 100% { opacity: .9; transform: scale(1); }
        50% { opacity: .15; transform: scale(.55); } }
    .wave-zone { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: 560px; height: 130px; }
    #pl-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .rb { fill: none; stroke-width: 12.5; stroke-linecap: butt; }
    #pl-nyan { position: absolute; width: 110px; z-index: 3; left: -60px; top: 0;
        image-rendering: pixelated; pointer-events: none;
        filter: drop-shadow(2px 0 0 rgba(10, 25, 60, .9)) drop-shadow(-2px 0 0 rgba(10, 25, 60, .9))
                drop-shadow(0 2px 0 rgba(10, 25, 60, .9)) drop-shadow(0 -2px 0 rgba(10, 25, 60, .9));
        animation: nyan-bob .55s ease-in-out infinite alternate; }
    @keyframes nyan-bob { from { margin-top: -6px; } to { margin-top: 5px; } }
    .pl-pct { position: absolute; left: 50%; top: calc(50% + 72px); transform: translate(-50%, -50%);
        font-family: Consolas, monospace; font-size: 24px; font-weight: bold;
        color: #fff; letter-spacing: 3px; text-shadow: 2px 2px 0 rgba(0, 0, 0, .45); }
</style>
<script>
    (function () {
        var W = 560, BAND = 12.5, AMP = 6.5, WAVELEN = 170, BASE = 30;
        var COLORS = ['#fe0000', '#ff8f00', '#ffff00', '#00d000', '#0099fe', '#6633fe'];
        var paths = [];
        for (var b = 0; b < 6; b++) {
            var p = document.getElementById('rb' + b);
            p.setAttribute('stroke', COLORS[b]);
            p.setAttribute('stroke-width', BAND + 1.2);
            paths.push(p);
        }
        var nyan = document.getElementById('pl-nyan');
        var cliprect = document.getElementById('pl-cliprect');
        var pctEl = document.getElementById('pl-pct');
        var phase = 0, pct = 0, target = 78, finished = false;
        var t0 = Date.now();

        function waveY(x, band) {
            return BASE + band * BAND + BAND / 2 + AMP * Math.sin((x + phase) / WAVELEN * Math.PI * 2);
        }
        function drawWave() {
            for (var b = 0; b < 6; b++) {
                var d = '';
                for (var x = 0; x <= W + 8; x += 7) {
                    d += (x === 0 ? 'M' : 'L') + x + ' ' + waveY(x, b).toFixed(1) + ' ';
                }
                paths[b].setAttribute('d', d);
            }
        }
        function setP(p) {
            pct = Math.max(0, Math.min(100, p));
            cliprect.setAttribute('width', (W * pct / 100 + 4).toFixed(1));
            pctEl.textContent = Math.round(pct) + '%';
            if (pct >= 100 && !finished) {
                finished = true;
                setTimeout(fade, 600);
            }
        }
        function fade() {
            var l = document.getElementById('page-loading');
            if (!l || l.classList.contains('fade')) return;
            l.classList.add('fade');
            setTimeout(function () { if (l.parentNode) l.parentNode.removeChild(l); }, 460);
        }
        /* 主循环: 彩虹流动 + 猫贴在裁剪边缘骑浪 */
        function frame() {
            requestAnimationFrame(frame);
            phase += 1.15;
            drawWave();
            var edgeX = W * pct / 100;
            nyan.style.left = (edgeX - 35) + 'px';
            nyan.style.top = (waveY(Math.min(edgeX, W), 2.5) - 60) + 'px';
        }
        frame();

        /* 进度: 爬到 78% -> DOMContentLoaded 88% -> load 100% */
        var tick = setInterval(function () {
            if (pct < target) setP(pct + 2 + Math.random() * 4);
        }, 130);
        document.addEventListener('DOMContentLoaded', function () {
            target = 88;
            if (pct < 82) setP(82);
        });
        window.addEventListener('load', function () {
            target = 100;
            if (pct < 96) setP(96);
        });
        setTimeout(function () { target = 100; if (pct < 96) setP(96); }, 6000);
        setTimeout(function () { finished = true; fade(); }, 7200);
        function schedule() {
            var el = Date.now() - t0;
            setTimeout(function () {
                if (!finished && pct < 60) setP(60);
            }, Math.max(0, 1500 - el));
        }
        if (document.readyState !== 'loading') schedule();
        else document.addEventListener('DOMContentLoaded', schedule);

        /* 窄屏缩放 */
        function fit() {
            var s = Math.min(1, window.innerWidth / 640);
            document.querySelector('.wave-zone').style.transform =
                'translate(-50%, -50%) scale(' + s + ')';
        }
        window.addEventListener('resize', fit);
        fit();
    })();
</script>
