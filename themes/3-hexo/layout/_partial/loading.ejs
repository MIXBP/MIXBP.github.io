<div id="page-loading">
    <div class="cloud c1"></div><div class="cloud c2"></div><div class="cloud c3"></div>
    <div class="cloud c4"></div><div class="cloud c5"></div>
    <div class="wave-zone">
        <svg id="pl-svg" viewBox="0 0 560 110" xmlns="http://www.w3.org/2000/svg">
            <defs><clipPath id="plclip"><rect id="pl-cliprect" x="-4" y="-10" width="0" height="130"/></clipPath></defs>
            <g clip-path="url(#plclip)">
                <path id="rb0" class="rb"/><path id="rb1" class="rb"/><path id="rb2" class="rb"/>
                <path id="rb3" class="rb"/><path id="rb4" class="rb"/><path id="rb5" class="rb"/>
            </g>
        </svg>
        <img id="pl-nyan" src="/img/nyan-cat.webp" alt="">
    </div>
    <div class="pl-pct" id="pl-pct">0%</div>
</div>
<style>
    /* 彩虹猫 loading: 蓝天白云 + 波浪彩虹进度 (0->100%) */
    #page-loading { position: fixed; inset: 0; z-index: 99999; overflow: hidden;
        background: linear-gradient(#7ec3f0, #b5defa 62%, #ddf0fc);
        transition: opacity .4s ease; }
    #page-loading.fade { opacity: 0; pointer-events: none; }
    /* 白云 */
    #page-loading .cloud { position: absolute; background: #fff; border-radius: 50px;
        opacity: .85; box-shadow: 0 6px 14px rgba(110, 150, 190, .22); }
    #page-loading .cloud::before, #page-loading .cloud::after { content: ''; position: absolute;
        background: #fff; border-radius: 50%; }
    #page-loading .c1 { width: 130px; height: 40px; left: 5%; top: 14%; animation: cloud-drift 26s linear infinite alternate; }
    #page-loading .c1::before { width: 55px; height: 55px; left: 22px; top: -26px; }
    #page-loading .c1::after { width: 40px; height: 40px; left: 66px; top: -16px; }
    #page-loading .c2 { width: 150px; height: 44px; right: 6%; top: 16%; opacity: .7; animation: cloud-drift 32s linear infinite alternate-reverse; }
    #page-loading .c2::before { width: 62px; height: 62px; left: 28px; top: -30px; }
    #page-loading .c2::after { width: 44px; height: 44px; left: 86px; top: -18px; }
    #page-loading .c3 { width: 100px; height: 32px; right: 22%; bottom: 16%; opacity: .6; animation: cloud-drift 24s linear infinite alternate-reverse; }
    #page-loading .c3::before { width: 46px; height: 46px; left: 20px; top: -22px; }
    #page-loading .c4 { width: 120px; height: 36px; left: 10%; bottom: 12%; opacity: .7; animation: cloud-drift 28s linear infinite alternate; }
    #page-loading .c4::before { width: 50px; height: 50px; left: 24px; top: -24px; }
    #page-loading .c5 { width: 140px; height: 40px; left: 44%; bottom: 8%; opacity: .65; animation: cloud-drift 30s linear infinite alternate; }
    #page-loading .c5::before { width: 56px; height: 56px; left: 26px; top: -26px; }
    @keyframes cloud-drift { from { transform: translateX(0); } to { transform: translateX(40px); } }
    .wave-zone { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: 560px; height: 130px; }
    #pl-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .rb { fill: none; stroke-width: 12.5; stroke-linecap: butt; stroke-linejoin: round; }
    #pl-nyan { position: absolute; width: 110px; z-index: 3; left: -60px; top: 0;
        image-rendering: pixelated; pointer-events: none;
        filter: drop-shadow(2px 0 0 rgba(10, 25, 60, .9)) drop-shadow(-2px 0 0 rgba(10, 25, 60, .9))
                drop-shadow(0 2px 0 rgba(10, 25, 60, .9)) drop-shadow(0 -2px 0 rgba(10, 25, 60, .9));
        animation: nyan-bob .55s ease-in-out infinite alternate; }
    @keyframes nyan-bob { from { margin-top: -6px; } to { margin-top: 5px; } }
    .pl-pct { position: absolute; left: 50%; top: calc(50% + 72px); transform: translate(-50%, -50%);
        font-family: Consolas, monospace; font-size: 24px; font-weight: bold;
        color: #fff; letter-spacing: 3px; text-shadow: 2px 2px 0 rgba(0, 0, 0, .45); }
</style>
<script>
    (function () {
        /* 仅首次访问首页展示; 本会话已展示过则直接移除, 跳过动画 */
        var shown = false;
        try { shown = sessionStorage.getItem('nyanLoadShown') === '1'; } catch (e) { }
        if (shown) {
            var old = document.getElementById('page-loading');
            if (old && old.parentNode) old.parentNode.removeChild(old);
            return;
        }
        try { sessionStorage.setItem('nyanLoadShown', '1'); } catch (e) { }

        var W = 560, BAND = 12.5, AMP = 10, WAVELEN = 190, BASE = 24;
        var STEP = 12, QUANT = 7;   /* 像素台阶: 台阶宽/高 */
        var COLORS = ['#fe0000', '#ff8f00', '#ffff00', '#00d000', '#0099fe', '#6633fe'];
        var paths = [];
        for (var b = 0; b < 6; b++) {
            var p = document.getElementById('rb' + b);
            p.setAttribute('stroke', COLORS[b]);
            p.setAttribute('stroke-width', BAND + 1.2);
            paths.push(p);
        }
        var nyan = document.getElementById('pl-nyan');
        var cliprect = document.getElementById('pl-cliprect');
        var pctEl = document.getElementById('pl-pct');
        var phase = 0, pct = 0, target = 78, finished = false;
        var t0 = Date.now();

        function waveY(x, band) {
            return BASE + band * BAND + BAND / 2 + AMP * Math.sin((x + phase) / WAVELEN * Math.PI * 2);
        }
        function stairY(x, band) {
            var y = BASE + band * BAND + BAND / 2 + AMP * Math.sin((x + phase) / WAVELEN * Math.PI * 2);
            return Math.round(y / QUANT) * QUANT;
        }
        /* 像素台阶波浪: 从屏幕外(-72)流入, 横->竖台阶拼接, 原版 GIF 的砌块感 */
        function drawWave() {
            for (var b = 0; b < 6; b++) {
                var d = '', prevY = null;
                for (var x = -72; x <= W + STEP; x += STEP) {
                    var y = stairY(x, b);
                    if (prevY === null) {
                        d += 'M' + x + ' ' + y + ' ';
                    } else {
                        d += 'L' + x + ' ' + prevY + ' L' + x + ' ' + y + ' ';
                    }
                    prevY = y;
                }
                paths[b].setAttribute('d', d);
            }
        }
        function setP(p) {
            pct = Math.max(0, Math.min(100, p));
            cliprect.setAttribute('width', (W * pct / 100 + 4).toFixed(1));
            pctEl.textContent = Math.round(pct) + '%';
            if (pct >= 100 && !finished) {
                finished = true;
                setTimeout(fade, 600);
            }
        }
        function fade() {
            var l = document.getElementById('page-loading');
            if (!l || l.classList.contains('fade')) return;
            l.classList.add('fade');
            setTimeout(function () { if (l.parentNode) l.parentNode.removeChild(l); }, 460);
        }
        /* 主循环: 彩虹流动 + 猫贴在裁剪边缘骑浪 */
        function frame() {
            requestAnimationFrame(frame);
            phase += 1.15;
            drawWave();
            var edgeX = W * pct / 100;
            nyan.style.left = (edgeX - 35) + 'px';
            nyan.style.top = (waveY(Math.min(edgeX, W), 2.5) - 60) + 'px';
        }
        frame();

        /* 真实加载: 进度绑定实际里程碑, 动画期间顺手预取前两篇文章 */
        var tick = setInterval(function () {
            if (pct < target) setP(pct + 1.5 + Math.random() * 3);
        }, 120);
        var domFired = false;
        function onDom() {
            if (domFired) return;
            domFired = true;
            target = 88;
            if (pct < 80) setP(80);
            /* 动画期间预取首页最新两篇文章, 点进去近乎秒开 */
            try {
                var links = document.querySelectorAll('#title-list-nav a');
                for (var i = 0; i < 2 && i < links.length; i++) {
                    var l = document.createElement('link');
                    l.rel = 'prefetch';
                    l.href = links[i].href;
                    l.as = 'document';
                    document.head.appendChild(l);
                }
            } catch (e) { }
            /* 页面已可用: 1.6s 后强制放行(图片在后台继续懒加载) */
            setTimeout(function () {
                if (target < 100) {
                    target = 100;
                    if (pct < 94) setP(94);
                }
            }, 1600);
        }
        if (document.readyState !== 'loading') onDom();
        else document.addEventListener('DOMContentLoaded', onDom);
        window.addEventListener('load', function () {
            target = 100;
            if (pct < 96) setP(96);
        });
        setTimeout(function () { target = 100; if (pct < 96) setP(96); }, 6000);
        setTimeout(function () { finished = true; fade(); }, 7200);

        /* 窄屏缩放 */
        function fit() {
            var s = Math.min(1, window.innerWidth / 640);
            document.querySelector('.wave-zone').style.transform =
                'translate(-50%, -50%) scale(' + s + ')';
        }
        window.addEventListener('resize', fit);
        fit();
    })();
</script>
